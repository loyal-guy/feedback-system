# ---------------------------------------------------------------
# FeedbackHub environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file or share it publicly.
# ---------------------------------------------------------------

# development = show detailed errors | production = hide errors, log them
APP_ENV=development
APP_NAME=FeedbackHub

# Leave empty to auto-detect (works on XAMPP, e.g. /feedback-system)
APP_BASE_URL=

# Database connection (XAMPP default: user "root" with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=feedback_system
DB_USER=root
DB_PASS=

# Security settings
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Set to true on a live server that has an SSL certificate (HTTPS)
FORCE_HTTPS=false
